# System & Environment
.env
*.local
*.log

# Caches & Temporary Artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.cache/

# uv / Ruff / pre-commit
# The environment and caches are local build products, never committed: uv.lock
# IS committed so the tool versions stay pinned. Source and test files are
# deliberately not ignored anywhere in this file.
#
# NOTE: do not add a `.pre-commit-*.yaml` glob here — it also matches the tracked
# `.pre-commit-config.yaml`, which would silently drop the hook configuration
# from every commit.
.venv/
.ruff_cache/

# Python packaging artefacts
build/
dist/
*.egg-info/

# Agent & Worktree runtime data
.worktrees/
.commandcode/
tmp/
scratch/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*~

